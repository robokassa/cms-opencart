{{ header }}{{ column_left }}
<div id="content" class="robokassa-settings">
  <div class="page-header robokassa-page-header">
    <div class="container-fluid">
      <div class="pull-right robokassa-header-actions">
        {% if show_update_methods %}
          <button type="submit" form="form-payment" name="robokassa_action" value="update_methods" class="btn btn-default">
            <i class="fa fa-refresh"></i> {{ button_update_methods }}
          </button>
        {% endif %}
        <button type="submit" form="form-payment" class="btn btn-primary">
          <i class="fa fa-save"></i> {{ button_save }}
        </button>
        <a href="{{ cancel }}" class="btn btn-default" data-toggle="tooltip" title="{{ button_cancel }}">
          <i class="fa fa-reply"></i>
        </a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    {% if success %}
      <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}
    {% if error_warning %}
      <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>
    {% endif %}

    <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment">
      <section class="robokassa-hero">
        <div class="robokassa-hero__brand">
          <div class="robokassa-hero__logo"><img src="view/image/payment/robokassa.png" alt="Robokassa"></div>
          <div>
            <h2>Настройки Robokassa для OpenCart</h2>
            <p>Подключение, чеки, способы оплаты и виджеты — в одном месте.</p>
          </div>
        </div>
        <label class="robokassa-master-switch">
          <input type="hidden" name="payment_robokassa_status" value="0">
          <input type="checkbox" name="payment_robokassa_status" value="1" {% if payment_robokassa_status %}checked{% endif %}>
          <span class="robokassa-switch" aria-hidden="true"></span>
          <span>Приём платежей</span>
        </label>
      </section>

      <nav class="robokassa-nav" aria-label="Разделы настроек">
        <button type="button" class="robokassa-nav__item is-active" data-robokassa-tab="connection">
          <i class="fa fa-plug"></i><span><strong>Подключение</strong><small>Магазин и API</small></span>
        </button>
        <button type="button" class="robokassa-nav__item" data-robokassa-tab="receipts">
          <i class="fa fa-file-text-o"></i><span><strong>Чеки</strong><small>Фискализация</small></span>
        </button>
        <button type="button" class="robokassa-nav__item" data-robokassa-tab="methods">
          <i class="fa fa-credit-card"></i><span><strong>Способы оплаты</strong><small>СБП и рассрочки</small></span>
        </button>
        <button type="button" class="robokassa-nav__item" data-robokassa-tab="widgets">
          <i class="fa fa-object-group"></i><span><strong>Виджеты</strong><small>Карточка товара</small></span>
        </button>
        <button type="button" class="robokassa-nav__item" data-robokassa-tab="advanced">
          <i class="fa fa-sliders"></i><span><strong>Дополнительно</strong><small>Поведение модуля</small></span>
        </button>
      </nav>

      <div class="robokassa-tab is-active" data-robokassa-panel="connection">
        <section class="robokassa-card">
          <div class="robokassa-card__header">
            <div><h3>Основные настройки</h3><p>Данные магазина и режим работы платёжного модуля.</p></div>
            <span class="robokassa-badge {% if payment_robokassa_test %}is-warning{% else %}is-success{% endif %}">{% if payment_robokassa_test %}Тестовый режим{% else %}Основной режим{% endif %}</span>
          </div>
          <div class="robokassa-form-grid">
            <div class="robokassa-field required">
              <label for="input-merch-login">{{ entry_merch_login }}</label>
              <input type="text" name="payment_robokassa_login" value="{{ payment_robokassa_login }}" id="input-merch-login" class="form-control" autocomplete="off">
              {% if error_merch_login %}<div class="text-danger">{{ error_merch_login }}</div>{% endif %}
            </div>
            <div class="robokassa-field">
              <label for="input-country">{{ entry_country }}</label>
              <select name="payment_robokassa_country" id="input-country" class="form-control">
                <option value="RUB" {% if payment_robokassa_country == 'RUB' %}selected{% endif %}>{{ text_ru }}</option>
                <option value="KZT" {% if payment_robokassa_country == 'KZT' %}selected{% endif %}>{{ text_kz }}</option>
              </select>
            </div>
            <div class="robokassa-field required">
              <label for="input-password-1">{{ entry_password1 }}</label>
              <input type="password" name="payment_robokassa_password_1" value="{{ payment_robokassa_password_1 }}" id="input-password-1" class="form-control" autocomplete="new-password">
              {% if error_password1 %}<div class="text-danger">{{ error_password1 }}</div>{% endif %}
            </div>
            <div class="robokassa-field required">
              <label for="input-password-2">{{ entry_password2 }}</label>
              <input type="password" name="payment_robokassa_password_2" value="{{ payment_robokassa_password_2 }}" id="input-password-2" class="form-control" autocomplete="new-password">
              {% if error_password2 %}<div class="text-danger">{{ error_password2 }}</div>{% endif %}
            </div>
            <div class="robokassa-field">
              <label for="input-password-3">{{ entry_password3 }}</label>
              <input type="password" name="payment_robokassa_password_3" value="{{ payment_robokassa_password_3 }}" id="input-password-3" class="form-control" autocomplete="new-password">
              <small>{{ help_password3 }}</small>
            </div>
            <div class="robokassa-field">
              <label for="input-test-password-1">{{ entry_test_password1 }}</label>
              <input type="password" name="payment_robokassa_test_password_1" value="{{ payment_robokassa_test_password_1 }}" id="input-test-password-1" class="form-control" autocomplete="new-password">
            </div>
            <div class="robokassa-field">
              <label for="input-test-password-2">{{ entry_test_password2 }}</label>
              <input type="password" name="payment_robokassa_test_password_2" value="{{ payment_robokassa_test_password_2 }}" id="input-test-password-2" class="form-control" autocomplete="new-password">
            </div>
            <div class="robokassa-field">
              <label for="input-test">{{ entry_test }}</label>
              <select name="payment_robokassa_test" id="input-test" class="form-control">
                <option value="0" {% if not payment_robokassa_test %}selected{% endif %}>{{ text_no }}</option>
                <option value="1" {% if payment_robokassa_test %}selected{% endif %}>{{ text_yes }}</option>
              </select>
            </div>
            <div class="robokassa-field">
              <label for="input-status-id">{{ entry_order_status }}</label>
              <select name="payment_robokassa_order_status_id" id="input-status-id" class="form-control">
                {% for order_status in order_statuses %}<option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == payment_robokassa_order_status_id %}selected{% endif %}>{{ order_status.name }}</option>{% endfor %}
              </select>
            </div>
          </div>
        </section>

        <section class="robokassa-card robokassa-card--compact">
          <div class="robokassa-card__header"><div><h3>URL для личного кабинета</h3><p>Скопируйте адреса и укажите их в технических настройках магазина Robokassa.</p></div></div>
          <div class="robokassa-url-list">
            <div><span>Result URL <small>POST</small></span><code id="robokassa-result-url">{{ payment_robokassa_result_url }}</code><button type="button" data-copy-target="robokassa-result-url"><i class="fa fa-copy"></i></button></div>
            <div><span>Success URL <small>GET</small></span><code id="robokassa-success-url">{{ payment_robokassa_success_url }}</code><button type="button" data-copy-target="robokassa-success-url"><i class="fa fa-copy"></i></button></div>
            <div><span>Fail URL <small>POST</small></span><code id="robokassa-fail-url">{{ payment_robokassa_fail_url }}</code><button type="button" data-copy-target="robokassa-fail-url"><i class="fa fa-copy"></i></button></div>
          </div>
        </section>
      </div>

      <div class="robokassa-tab" data-robokassa-panel="receipts">
        <section class="robokassa-card">
          <div class="robokassa-card__header"><div><h3>Фискализация и маркировка</h3><p>Параметры формирования первого и итогового чеков.</p></div></div>
          <div class="robokassa-form-grid">
            <div class="robokassa-field">
              <label for="input-fiscal"><span data-toggle="tooltip" title="{{ help_fiscal }}">{{ entry_fiscal }}</span></label>
              <select name="payment_robokassa_fiscal" id="input-fiscal" class="form-control"><option value="0" {% if not payment_robokassa_fiscal %}selected{% endif %}>{{ text_no }}</option><option value="1" {% if payment_robokassa_fiscal %}selected{% endif %}>{{ text_yes }}</option></select>
            </div>
            <div class="robokassa-field" data-fiscal-only data-russia-only>
              <label for="input-marking"><span data-toggle="tooltip" title="{{ help_marking }}">{{ entry_marking }}</span></label>
              <select name="payment_robokassa_marking" id="input-marking" class="form-control"><option value="0" {% if not payment_robokassa_marking %}selected{% endif %}>{{ text_no }}</option><option value="1" {% if payment_robokassa_marking %}selected{% endif %}>{{ text_yes }}</option></select>
            </div>
            <div class="robokassa-field" data-fiscal-only>
              <label for="input-tax-type">{{ entry_tax_type }}</label>
              <select name="payment_robokassa_tax_type" id="input-tax-type" class="form-control">{% for key, value in robokassa_tax_type_list %}<option value="{{ key }}" {% if payment_robokassa_tax_type == key %}selected{% endif %}>{{ value }}</option>{% endfor %}</select>
            </div>
            <div class="robokassa-field" data-fiscal-only>
              <label for="input-tax">{{ entry_tax }}</label>
              <select name="payment_robokassa_tax" id="input-tax" class="form-control">
                {% if payment_robokassa_country == 'KZT' %}{% for key, value in robokassa_tax_list_kz %}<option value="{{ key }}" {% if payment_robokassa_tax == key %}selected{% endif %}>{{ value }}</option>{% endfor %}{% else %}{% for key, value in robokassa_tax_list %}<option value="{{ key }}" {% if payment_robokassa_tax == key %}selected{% endif %}>{{ value }}</option>{% endfor %}{% endif %}
              </select>
            </div>
            <div class="robokassa-field" data-fiscal-only data-russia-only>
              <label for="input-payment-method">{{ entry_payment_method }}</label>
              <select name="payment_robokassa_payment_method" id="input-payment-method" class="form-control">{% for key, value in robokassa_payment_method_list %}<option value="{{ key }}" {% if payment_robokassa_payment_method == key %}selected{% endif %}>{{ value }}</option>{% endfor %}</select>
            </div>
            <div class="robokassa-field" data-fiscal-only data-russia-only>
              <label for="input-payment-object">{{ entry_payment_object }}</label>
              <select name="payment_robokassa_payment_object" id="input-payment-object" class="form-control">{% for key, value in robokassa_payment_object_list %}<option value="{{ key }}" {% if payment_robokassa_payment_object == key %}selected{% endif %}>{{ value }}</option>{% endfor %}</select>
            </div>
            <div class="robokassa-field robokassa-field--wide" data-fiscal-only data-russia-only>
              <label for="input-status-id-check2">Статус заказа для итогового чека</label>
              <select name="payment_robokassa_order_status_id_2check" id="input-status-id-check2" class="form-control"><option value="0">Не выбрано</option>{% for order_status in order_statuses %}<option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == payment_robokassa_order_status_id_2check %}selected{% endif %}>{{ order_status.name }}</option>{% endfor %}</select>
              <small>Итоговый чек отправится один раз при переходе заказа в выбранный статус.</small>
            </div>
          </div>
        </section>
      </div>

      <div class="robokassa-tab" data-robokassa-panel="methods">
        <section class="robokassa-card">
          <div class="robokassa-card__header">
            <div><h3>Дополнительные способы оплаты</h3><p>Они останутся отдельными вариантами для покупателя, но управляются из этой страницы.</p></div>
            {% if show_update_methods %}<button type="submit" name="robokassa_action" value="update_methods" class="btn btn-default"><i class="fa fa-refresh"></i> {{ button_update_methods }}</button>{% endif %}
          </div>
          <div class="robokassa-method-grid">
            {% for method in robokassa_payment_methods %}
              <article class="robokassa-method-card {% if method.enabled %}is-enabled{% endif %}">
                <div class="robokassa-method-card__icon"><i class="fa {% if method.code == 'sbp' %}fa-qrcode{% else %}fa-credit-card{% endif %}"></i></div>
                <div class="robokassa-method-card__content">
                  <div class="robokassa-method-card__title"><h4>{{ method.title }}</h4>{% if method.availability_known %}<span class="robokassa-availability {% if method.available %}is-available{% else %}is-unavailable{% endif %}">{% if method.available %}Доступен{% else %}Недоступен магазину{% endif %}</span>{% else %}<span class="robokassa-availability">Не проверен</span>{% endif %}</div>
                  <p>{{ method.description }}</p>
                </div>
                <label class="robokassa-toggle" title="Включить способ оплаты">
                  <input type="hidden" name="{{ method.setting_key }}" value="0">
                  <input type="checkbox" name="{{ method.setting_key }}" value="1" {% if method.enabled %}checked{% endif %}>
                  <span class="robokassa-switch" aria-hidden="true"></span>
                </label>
              </article>
            {% endfor %}
          </div>
          <div class="robokassa-inline-note"><i class="fa fa-info-circle"></i><span>Список доступности берётся из Robokassa. Если вы подключили новый способ в личном кабинете, нажмите «{{ button_update_methods }}».</span></div>
        </section>
      </div>

      <div class="robokassa-tab" data-robokassa-panel="widgets">
        <section class="robokassa-card">
          <div class="robokassa-card__header">
            <div><h3>Виджеты в карточке товара</h3><p>Настройте внешний вид блоков оплаты частями, кредита и рассрочки.</p></div>
            <label class="robokassa-toggle robokassa-toggle--labeled"><input type="hidden" name="payment_robokassa_widget_status" value="0"><input type="checkbox" name="payment_robokassa_widget_status" value="1" {% if payment_robokassa_widget_status %}checked{% endif %}><span class="robokassa-switch"></span><strong>Показывать виджеты</strong></label>
          </div>
          <div class="robokassa-widget-grid">
            <div class="robokassa-subcard">
              <h4><i class="fa fa-pie-chart"></i> Оплата частями</h4>
              <div class="robokassa-form-grid robokassa-form-grid--single">
                <div class="robokassa-field"><label for="input-bnpl-theme">Тема</label><select name="payment_robokassa_widget_bnpl_theme" id="input-bnpl-theme" class="form-control"><option value="light" {% if payment_robokassa_widget_bnpl_theme == 'light' %}selected{% endif %}>Светлая</option><option value="dark" {% if payment_robokassa_widget_bnpl_theme == 'dark' %}selected{% endif %}>Тёмная</option></select></div>
                <div class="robokassa-field"><label for="input-bnpl-size">Размер</label><select name="payment_robokassa_widget_bnpl_size" id="input-bnpl-size" class="form-control"><option value="s" {% if payment_robokassa_widget_bnpl_size == 's' %}selected{% endif %}>S</option><option value="m" {% if payment_robokassa_widget_bnpl_size == 'm' %}selected{% endif %}>M</option></select></div>
                <div class="robokassa-field"><label for="input-bnpl-logo">Показывать логотип</label><select name="payment_robokassa_widget_bnpl_show_logo" id="input-bnpl-logo" class="form-control"><option value="1" {% if payment_robokassa_widget_bnpl_show_logo %}selected{% endif %}>{{ text_yes }}</option><option value="0" {% if not payment_robokassa_widget_bnpl_show_logo %}selected{% endif %}>{{ text_no }}</option></select></div>
                <div class="robokassa-field"><label for="input-bnpl-radius">Скругление углов</label><input type="number" min="0" max="100" name="payment_robokassa_widget_bnpl_border_radius" value="{{ payment_robokassa_widget_bnpl_border_radius }}" id="input-bnpl-radius" class="form-control"></div>
                <div class="robokassa-field"><label for="input-bnpl-second-line">Вторая строка</label><select name="payment_robokassa_widget_bnpl_has_second_line" id="input-bnpl-second-line" class="form-control"><option value="1" {% if payment_robokassa_widget_bnpl_has_second_line %}selected{% endif %}>{{ text_yes }}</option><option value="0" {% if not payment_robokassa_widget_bnpl_has_second_line %}selected{% endif %}>{{ text_no }}</option></select></div>
                <div class="robokassa-field"><label for="input-bnpl-position">Позиция описания</label><select name="payment_robokassa_widget_bnpl_description_position" id="input-bnpl-position" class="form-control"><option value="left" {% if payment_robokassa_widget_bnpl_description_position == 'left' %}selected{% endif %}>Слева</option><option value="right" {% if payment_robokassa_widget_bnpl_description_position == 'right' %}selected{% endif %}>Справа</option></select></div>
              </div>
            </div>
            <div class="robokassa-subcard robokassa-subcard--dark">
              <h4><i class="fa fa-line-chart"></i> Кредит и рассрочка</h4>
              <div class="robokassa-form-grid robokassa-form-grid--single">
                <div class="robokassa-field"><label for="input-credit-theme">Тема</label><select name="payment_robokassa_widget_credit_theme" id="input-credit-theme" class="form-control"><option value="light" {% if payment_robokassa_widget_credit_theme == 'light' %}selected{% endif %}>Светлая</option><option value="dark" {% if payment_robokassa_widget_credit_theme == 'dark' %}selected{% endif %}>Тёмная</option></select></div>
                <div class="robokassa-field"><label for="input-credit-size">Размер</label><select name="payment_robokassa_widget_credit_size" id="input-credit-size" class="form-control"><option value="s" {% if payment_robokassa_widget_credit_size == 's' %}selected{% endif %}>S</option><option value="m" {% if payment_robokassa_widget_credit_size == 'm' %}selected{% endif %}>M</option></select></div>
                <div class="robokassa-field"><label for="input-credit-logo">Показывать логотип</label><select name="payment_robokassa_widget_credit_show_logo" id="input-credit-logo" class="form-control"><option value="1" {% if payment_robokassa_widget_credit_show_logo %}selected{% endif %}>{{ text_yes }}</option><option value="0" {% if not payment_robokassa_widget_credit_show_logo %}selected{% endif %}>{{ text_no }}</option></select></div>
                <div class="robokassa-field"><label for="input-credit-radius">Скругление углов</label><input type="number" min="0" max="100" name="payment_robokassa_widget_credit_border_radius" value="{{ payment_robokassa_widget_credit_border_radius }}" id="input-credit-radius" class="form-control"></div>
                <div class="robokassa-field"><label for="input-credit-second-line">Вторая строка</label><select name="payment_robokassa_widget_credit_has_second_line" id="input-credit-second-line" class="form-control"><option value="1" {% if payment_robokassa_widget_credit_has_second_line %}selected{% endif %}>{{ text_yes }}</option><option value="0" {% if not payment_robokassa_widget_credit_has_second_line %}selected{% endif %}>{{ text_no }}</option></select></div>
                <div class="robokassa-field"><label for="input-credit-position">Позиция описания</label><select name="payment_robokassa_widget_credit_description_position" id="input-credit-position" class="form-control"><option value="left" {% if payment_robokassa_widget_credit_description_position == 'left' %}selected{% endif %}>Слева</option><option value="right" {% if payment_robokassa_widget_credit_description_position == 'right' %}selected{% endif %}>Справа</option></select></div>
              </div>
            </div>
          </div>
        </section>
      </div>

      <div class="robokassa-tab" data-robokassa-panel="advanced">
        <section class="robokassa-card">
          <div class="robokassa-card__header"><div><h3>Дополнительные настройки</h3><p>География, отображение и технические параметры модуля.</p></div></div>
          <div class="robokassa-form-grid">
            <div class="robokassa-field"><label for="input-geo-zone">{{ entry_geo_zone }}</label><select name="payment_robokassa_geo_zone_id" id="input-geo-zone" class="form-control"><option value="0">{{ text_all_zones }}</option>{% for geo_zone in geo_zones %}<option value="{{ geo_zone.geo_zone_id }}" {% if geo_zone.geo_zone_id == payment_robokassa_geo_zone_id %}selected{% endif %}>{{ geo_zone.name }}</option>{% endfor %}</select></div>
            <div class="robokassa-field"><label for="input-sort-order">{{ entry_sort_order }}</label><input type="number" name="payment_robokassa_sort_order" value="{{ payment_robokassa_sort_order }}" id="input-sort-order" class="form-control"></div>
            <div class="robokassa-field"><label for="input-product-options">{{ entry_product_options }}</label><select name="payment_robokassa_send_product_options" id="input-product-options" class="form-control"><option value="1" {% if payment_robokassa_send_product_options %}selected{% endif %}>{{ text_enabled }}</option><option value="0" {% if not payment_robokassa_send_product_options %}selected{% endif %}>{{ text_disabled }}</option></select></div>
            <div class="robokassa-field"><label for="input-iframe"><span data-toggle="tooltip" title="{{ help_iframe }}">{{ entry_iframe }}</span></label><select name="payment_robokassa_status_iframe" id="input-iframe" class="form-control"><option value="1" {% if payment_robokassa_status_iframe %}selected{% endif %}>{{ text_enabled }}</option><option value="0" {% if not payment_robokassa_status_iframe %}selected{% endif %}>{{ text_disabled }}</option></select></div>
            <div class="robokassa-field"><label for="input-hold"><span data-toggle="tooltip" title="{{ help_hold }}">{{ entry_hold }}</span></label><select name="payment_robokassa_status_hold" id="input-hold" class="form-control"><option value="1" {% if payment_robokassa_status_hold %}selected{% endif %}>{{ text_enabled }}</option><option value="0" {% if not payment_robokassa_status_hold %}selected{% endif %}>{{ text_disabled }}</option></select></div>
            <div class="robokassa-field"><label for="input-hold-pending-status">{{ entry_hold_pending_status }}</label><select name="payment_robokassa_hold_pending_status_id" id="input-hold-pending-status" class="form-control">{% for order_status in order_statuses %}<option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == payment_robokassa_hold_pending_status_id %}selected{% endif %}>{{ order_status.name }}</option>{% endfor %}</select><small>{{ help_hold_statuses }}</small></div>
            <div class="robokassa-field"><label for="input-hold-confirm-status">{{ entry_hold_confirm_status }}</label><select name="payment_robokassa_hold_confirm_status_id" id="input-hold-confirm-status" class="form-control">{% for order_status in order_statuses %}<option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == payment_robokassa_hold_confirm_status_id %}selected{% endif %}>{{ order_status.name }}</option>{% endfor %}</select></div>
            <div class="robokassa-field"><label for="input-hold-cancel-status">{{ entry_hold_cancel_status }}</label><select name="payment_robokassa_hold_cancel_status_id" id="input-hold-cancel-status" class="form-control">{% for order_status in order_statuses %}<option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == payment_robokassa_hold_cancel_status_id %}selected{% endif %}>{{ order_status.name }}</option>{% endfor %}</select></div>
            <div class="robokassa-field"><label for="input-refund-status">Статус после полного возврата</label><select name="payment_robokassa_refund_status_id" id="input-refund-status" class="form-control">{% for order_status in order_statuses %}<option value="{{ order_status.order_status_id }}" {% if order_status.order_status_id == payment_robokassa_refund_status_id %}selected{% endif %}>{{ order_status.name }}</option>{% endfor %}</select><small>При частичном возврате статус заказа не меняется.</small></div>
            <div class="robokassa-field robokassa-field--wide"><label>{{ entry_languages_map }}</label><div class="robokassa-language-grid">{% for language in opencart_languages %}<label><span>{{ language.name }}</span><select class="form-control" name="payment_robokassa_languages_map[{{ language.language_id }}]">{% for robokassa_language in robokassa_available_languages %}<option value="{{ robokassa_language }}" {% if payment_robokassa_languages_map[language.language_id] == robokassa_language %}selected{% endif %}>{{ robokassa_language }}</option>{% endfor %}</select></label>{% endfor %}</div></div>
          </div>
        </section>
        <section class="robokassa-card robokassa-card--compact">
          <div class="robokassa-card__header"><div><h3>Автоматическая проверка возвратов</h3><p>Добавьте этот URL в cron с интервалом около 5 минут.</p></div></div>
          <div class="robokassa-url-list"><div><span>Refund cron <small>GET</small></span><code id="robokassa-refund-cron-url">{{ payment_robokassa_refund_cron_url }}</code><div class="robokassa-url-actions"><button type="button" data-copy-url="{{ payment_robokassa_refund_cron_copy_url }}" title="Скопировать полный URL"><i class="fa fa-copy"></i></button><button type="button" data-regenerate-url="{{ payment_robokassa_refund_cron_regenerate_url }}" data-confirm="Старый cron URL перестанет работать. Новый URL будет скопирован — не забудьте обновить cron. Продолжить?" title="Создать новый токен"><i class="fa fa-refresh"></i></button></div></div></div>
        </section>
      </div>

      <div class="robokassa-savebar">
        <span><i class="fa fa-shield"></i> Настройки применяются ко всем способам оплаты Robokassa.</span>
        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button>
      </div>
    </form>
  </div>
</div>
{{ footer }}
