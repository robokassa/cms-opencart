<div class="tab-pane" id="tab-robokassa-marking">
  <div class="form-group">
    <label class="col-sm-2 control-label" for="input-robokassa-marking-required">
      <span data-toggle="tooltip" title="{{ help_marking_required }}">{{ entry_marking_required }}</span>
    </label>
    <div class="col-sm-10">
      <select name="robokassa_marking_required" id="input-robokassa-marking-required" class="form-control">
        <option value="1"{% if robokassa_marking_required %} selected="selected"{% endif %}>{{ text_yes }}</option>
        <option value="0"{% if not robokassa_marking_required %} selected="selected"{% endif %}>{{ text_no }}</option>
      </select>
    </div>
  </div>
</div>
