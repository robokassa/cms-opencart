<div class="row mb-3">
  <label for="input-robokassa-marking-required" class="col-sm-2 col-form-label" title="{{ help_marking_required }}">{{ entry_marking_required }}</label>
  <div class="col-sm-10">
    <select name="robokassa_marking_required" id="input-robokassa-marking-required" class="form-select">
      <option value="1"{% if robokassa_marking_required %} selected{% endif %}>{{ text_yes }}</option>
      <option value="0"{% if not robokassa_marking_required %} selected{% endif %}>{{ text_no }}</option>
    </select>
    <div class="form-text">{{ help_marking_required }}</div>
  </div>
</div>
